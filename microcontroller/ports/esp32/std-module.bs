code`
#include <string.h>
#include <stdio.h>
#include "freertos/task.h"
#include "esp_timer.h"
#include "protocol.h"
#include "./include/messaging.h"
#include "c-runtime.h"
#include "./include/std-module.h"

#define BUFF_SIZE 256

char buff[BUFF_SIZE];

void clear_buff() {
    memset(buff, 0, BUFF_SIZE);
}

void write_message_to_buff(value_t message) {
    if (is_int_value(message)) 
        sprintf(buff, "%d\n", (int) value_to_int(message));
    else if (is_float_value(message))
        sprintf(buff, "%f\n", value_to_float(message));
    else if (message == VALUE_NULL || message == VALUE_UNDEF)
        sprintf(buff, "undefined\n");
    else if (message == VALUE_TRUE)
        sprintf(buff, "true\n");
    else if (message == VALUE_FALSE)
        sprintf(buff, "false\n");
    else if (gc_is_string_object(message))
        snprintf(buff, sizeof(buff), "%s\n", gc_string_to_cstr(message));
    else {
        class_object* cls = gc_get_class_of(message);
        if (cls == NULL)
        sprintf(buff, "??\n");
        else
        snprintf(buff, sizeof(buff), "<class %s>\n", cls->name);
    }
    printf(buff);
}

// Milliseconds since the first call. esp_timer_get_time() is monotonic.
static float performance_now_ms() {
    static int64_t origin_us = -1;
    int64_t now_us = esp_timer_get_time();
    if (origin_us < 0)
        origin_us = now_us;

    return (float)((now_us - origin_us) / 1000.0);
}

`

function print(message: any) {
    code`
    clear_buff();
    write_message_to_buff(${message});
    bs_protocol_write_log(buff);
    `
}

function performanceNow(): float {
    let t: float = 0.0;
    code`${t} = performance_now_ms();`;
    return t;
}

// Messages between the projects in a workspace (see `bscript workspace run`).
// The C side is in main/messaging.c.
function sendInteger(dst: string, tag: string, value: integer) {
    code`bs_messaging_send_integer(${dst}, ${tag}, ${value});`
}

function broadcastInteger(tag: string, value: integer) {
    code`bs_messaging_broadcast_integer(${tag}, ${value});`
}

function receiveInteger(src: string, tag: string): integer {
    let value: integer = 0
    code`${value} = bs_messaging_receive_integer(${src}, ${tag});`
    return value
}

function sendFloat(dst: string, tag: string, value: float) {
    code`bs_messaging_send_float(${dst}, ${tag}, ${value});`
}

function broadcastFloat(tag: string, value: float) {
    code`bs_messaging_broadcast_float(${tag}, ${value});`
}

function receiveFloat(src: string, tag: string): float {
    let value: float = 0.0
    code`${value} = bs_messaging_receive_float(${src}, ${tag});`
    return value
}

function sendBoolean(dst: string, tag: string, value: boolean) {
    code`bs_messaging_send_boolean(${dst}, ${tag}, ${value});`
}

function broadcastBoolean(tag: string, value: boolean) {
    code`bs_messaging_broadcast_boolean(${tag}, ${value});`
}

function receiveBoolean(src: string, tag: string): boolean {
    let value: boolean = false
    code`${value} = bs_messaging_receive_boolean(${src}, ${tag});`
    return value
}

function sendString(dst: string, tag: string, value: string) {
    code`bs_messaging_send_string(${dst}, ${tag}, ${value});`
}

function broadcastString(tag: string, value: string) {
    code`bs_messaging_broadcast_string(${tag}, ${value});`
}

function receiveString(src: string, tag: string): string {
    let value: string = ""
    code`${value} = bs_messaging_receive_string(${src}, ${tag});`
    return value
}

function sendNull(dst: string, tag: string, value: null) {
    code`bs_messaging_send_null(${dst}, ${tag});`
}

function broadcastNull(tag: string, value: null) {
    code`bs_messaging_broadcast_null(${tag});`
}

function receiveNull(src: string, tag: string): null {
    code`bs_messaging_receive_null(${src}, ${tag});`
    return null
}

function sendIntegerArray(dst: string, tag: string, value: integer[]) {
    code`bs_messaging_send_integer_array(${dst}, ${tag}, ${value});`
}

function broadcastIntegerArray(tag: string, value: integer[]) {
    code`bs_messaging_broadcast_integer_array(${tag}, ${value});`
}

function receiveIntegerArray(src: string, tag: string): integer[] {
    let value: integer[] = new Array<integer>(0, 0)
    code`${value} = bs_messaging_receive_integer_array(${src}, ${tag});`
    return value
}

function sendFloatArray(dst: string, tag: string, value: float[]) {
    code`bs_messaging_send_float_array(${dst}, ${tag}, ${value});`
}

function broadcastFloatArray(tag: string, value: float[]) {
    code`bs_messaging_broadcast_float_array(${tag}, ${value});`
}

function receiveFloatArray(src: string, tag: string): float[] {
    let value: float[] = new Array<float>(0, 0.0)
    code`${value} = bs_messaging_receive_float_array(${src}, ${tag});`
    return value
}

function sendBooleanArray(dst: string, tag: string, value: boolean[]) {
    code`bs_messaging_send_boolean_array(${dst}, ${tag}, ${value});`
}

function broadcastBooleanArray(tag: string, value: boolean[]) {
    code`bs_messaging_broadcast_boolean_array(${tag}, ${value});`
}

function receiveBooleanArray(src: string, tag: string): boolean[] {
    let value: boolean[] = new Array<boolean>(0, false)
    code`${value} = bs_messaging_receive_boolean_array(${src}, ${tag});`
    return value
}

function sendArray(dst: string, tag: string, value: any[]) {
    code`bs_messaging_send_array(${dst}, ${tag}, ${value});`
}

function broadcastArray(tag: string, value: any[]) {
    code`bs_messaging_broadcast_array(${tag}, ${value});`
}

function receiveArray(src: string, tag: string): any[] {
    let value: any[] = []
    code`${value} = bs_messaging_receive_array(${src}, ${tag});`
    return value
}

class Console {
    log(message: any) {
        code`
    clear_buff();
    write_message_to_buff(${message});
    bs_protocol_write_log(buff);
        `
    }

    error(message: any) {
        code`
    clear_buff();
    write_message_to_buff(${message});
    bs_protocol_write_error(buff);
        `
    }
}


class Time {
    now(): float {
        let currentTime: float = 0.0;
        code`${currentTime} = esp_timer_get_time() / 1000.0;`;
        return currentTime;
    }

    delay(ms: integer) {
        code`vTaskDelay(pdMS_TO_TICKS(${ms}));`
    }
}

const console = new Console();
const time = new Time();
